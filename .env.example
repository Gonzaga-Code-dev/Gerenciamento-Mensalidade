# --- Banco de dados (Supabase / PostgreSQL) ---
# No Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = "Connection pooling" (porta 6543, com ?pgbouncer=true) — usada pela aplicação.
# DIRECT_URL   = "Direct connection" (porta 5432) — usada apenas para rodar migrations.
DATABASE_URL="postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Sessão/login ---
# NUNCA reutilize o valor abaixo. Gere um valor único forte com:
#   openssl rand -base64 48
SESSION_SECRET="GERE_UM_VALOR_UNICO_COM_openssl_rand_-base64_48"

# --- Usuário administrador (usado apenas por `npm run db:seed`) ---
ADMIN_NAME="Pai de Santo"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="defina-uma-senha-forte"

# --- Opcional: extração mais inteligente das mensagens coladas do WhatsApp ---
ANTHROPIC_API_KEY=

# --- Opcional: integração automática com WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
